{
  "expo": {
    "name": "IzmaBullet",
    "slug": "izmabullet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "izmabullet",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f6f7fb"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.izmabullet.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f6f7fb"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      ["expo-router", { "root": "./src/app" }],
      "expo-sqlite",
      [
        "expo-calendar",
        {
          "calendarPermission": "IzmaBullet necesita acceso al calendario para crear eventos de tus hábitos y fechas límite de tus objetivos. Solo modifica los eventos que crea la propia app."
        }
      ],
      "expo-notifications"
    ]
  }
}
